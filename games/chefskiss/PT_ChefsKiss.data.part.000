achievement_graveyard3 = "Surf every corpse in Wasteyard"
achievement_farm1title = "No One Is Safe"
achievement_farm1 = "Kill three unreachable enemies at once\nwith the supertaunt in Fun Farm"
achievement_farm2title = "Cube Menace"
achievement_farm2 = "Find and destroy the Mort cube"
achievement_farm3title = "Good Egg"
achievement_farm3 = "Complete Fun Farm while avoiding getting hurt with\nMort on you."
achievement_saloon1title = "Non Alcoholic"
achievement_saloon1 = "Destroy nearly every beer bottle\nin Fastfood Saloon"
achievement_saloon2title = "Already Pressed"
achievement_saloon2 = "Activate each button only once in Fastfood Saloon"
achievement_saloon3title = "Royal Flush"
achievement_saloon3 = "Touch every single card in Fastfood Saloon"
# ----- WORLD 3 ------
achievement_plage1title = "Blowback"
achievement_plage1 = "Kill a cannon goblin with his own bomb\nin Crust Cove"
achievement_plage2title = "X"
achievement_plage2 = "Uncover all the treasure guys in Crust Cove"
achievement_plage3title = "Demolition Expert"
achievement_plage3 = "Complete Crust Cove without getting hit by an\nexplosion"
achievement_forest1title = "Bee Nice"
achievement_forest1 = "Stand next to a bee and taunt in Gnome Forest"
achievement_forest2title = "Lumberjack"
achievement_forest2 = "Destroy every wood block in Gnome Forest"
achievement_forest3title = "Bullseye"
achievement_forest3 = "Kill a noise goblin with his own arrow\nin Gnome Forest"
achievement_space1title = "Turbo Tunnel"
achievement_space1 = "Avoid hitting the ceiling during the room\nright after the John Pillar in Deep Dish Nine"
achievement_space2title = "Blast Em Asteroids"
achievement_space2 = "Destroy all asteroids in Deep Dish Nine"
achievement_space3title = "Man Meteor"
achievement_space3 = "Kill 5 UFOlives in a single bodyslam\nin Deep Dish Nine"
achievement_minigolf1title = "Primo Golfer"
achievement_minigolf1 = "Get the highest rank in the courses of Golf"
achievement_minigolf2title = "Nice Shot"
achievement_minigolf2 = "Kill three or more enemies in a single stroke in Golf"
achievement_minigolf3title = "Helpful Burger"
achievement_minigolf3 = "Get a burger enemy to hit the ball inside the goal"
# ----- WORLD 4 ------
achievement_street1title = "Pan Fried"
achievement_street1 = "Find the bacon room"
achievement_street2title = "Strike!"
achievement_street2 = "Kill three or more enemies with a single Brick ball\nin Pig City"
achievement_street3title = "Say Oink!"
achievement_street3 = "Take a photo with every Pig City citizen"
achievement_sewer1title = "Cant Fool Me"
achievement_sewer1 = "Avoid killing any pizzaboy cardboard in Oh Shit!"
achievement_sewer2title = "Food Clan"
achievement_sewer2 = "Kill ten ninjas by parrying them in Oh Shit!"
achievement_sewer3title = "Penny Pincher"
achievement_sewer3 = "Avoid getting grabbed by Mr Pinch\nduring the escape sequence of Oh Shit!"
achievement_industrial1title = "Unflattening"
achievement_industrial1 = "Remove the boxxed transformation from each priest\nat least once in Peppibot Factory"
achievement_industrial2title = "Whoop This!"
achievement_industrial2 = "Survive the first secret of Peppibot Factory\nwithout getting hurt"
achievement_industrial3title = "There Can Be Only One"
achievement_industrial3 = "Destroy every Peppino robot in Peppibot Factory"
achievement_freezer1title = "Frozen Nuggets"
achievement_freezer1 = "Free all the frozen birds in Freezerator"
achievement_freezer2title = "Seasons Greetings"
achievement_freezer2 = "Kill 5 fake santas in Freezerator"
achievement_freezer3title = "Ice Climber"
achievement_freezer3 = "Complete Freezerator without falling in a pit"
# ----- WORLD 5 ------
achievement_chateau1title = "Cross To Bare"
achievement_chateau1 = "Kill thirty ghosts in Pizzascare"
achievement_chateau2title = "Haunted Playground"
achievement_chateau2 = "Avoid getting hurt by the King Ghosts traps\nin Pizzascare"
achievement_chateau3title = "Skullsplitter"
achievement_chateau3 = "Destroy every single skull block in Pizzascare"
achievement_kidsparty1title = "And This... Is My Gun On A Stick!"
